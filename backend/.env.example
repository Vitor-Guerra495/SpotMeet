# Copie para .env (mesma pasta) e preencha os valores.
# Requisitos: JDK 21 e PostgreSQL 18.

# Porta HTTP do backend
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/spotmeet_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT: chave Base64 com pelo menos 256 bits. Gerar: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# SMTP para envio de codigos de verificacao (Gmail com senha de app)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
