# Copie para .env (mesma pasta) e preencha os valores.
# Requisitos: JDK 21 e PostgreSQL 18 (instalação local ou em contêiner).

# Porta HTTP do backend
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/spotmeet_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT: chave Base64 com pelo menos 256 bits. Gerar: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# SMTP para envio dos códigos de verificação e dos avisos (Gmail com senha de app)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Login com Google (só no Android): ID do cliente OAuth "Aplicativo da Web". Não é segredo.
# Comentado, vale o ID do projeto definido no application.properties. Vazio, o botão fica indisponivel.
# GOOGLE_CLIENT_ID=
