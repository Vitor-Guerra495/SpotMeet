# Copie para .env (mesma pasta) somente se precisar sobrescrever a deteccao automatica.
# Por padrao o app descobre o IP do computador que roda o Metro/Expo e usa a porta 8080.

# IP ou host do backend (deixe vazio para deteccao automatica)
EXPO_PUBLIC_API_HOST=
# Porta do backend (padrao 8080, deve ser igual a SERVER_PORT do backend/.env)
EXPO_PUBLIC_API_PORT=8080
# http ou https
EXPO_PUBLIC_API_SCHEME=http

# Em builds instalados (APK/IPA) nao existe servidor do Expo para detectar o IP.
# Nesse caso informe o IP do backend direto na tela de login, em "Servidor",
# ou fixe EXPO_PUBLIC_API_HOST acima antes de gerar o build.
