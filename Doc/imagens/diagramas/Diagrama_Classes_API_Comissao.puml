  +listCommittees(organizationId: Long, userEmail: String): List<CommitteeResponseDTO>
  +updateCommittee(committeeId: Long, leaderEmail: String, dto: CommitteeRequestDTO): CommitteeResponseDTO
  +deleteCommittee(committeeId: Long, leaderEmail: String): void
  +listUserCommitteeLinks(organizationId: Long, targetUserId: Long, executorEmail: String): List<UserCommitteeLinkDTO>
  +addUserToCommittee(committeeId: Long, targetUserId: Long, leaderEmail: String): CommitteeMemberResponseDTO
  +removeUserFromCommittee(committeeId: Long, targetUserId: Long, leaderEmail: String): void
  +listInviteCandidates(committeeId: Long, leaderEmail: String): List<InviteCandidateDTO>
  +listActiveMembers(committeeId: Long, userEmail: String): List<CommitteeMemberResponseDTO>
  +listPresidedCommittees(userEmail: String): List<CommitteeMemberResponseDTO>
  +assignPresident(committeeId: Long, targetUserId: Long, leaderEmail: String): CommitteeMemberResponseDTO
  +listMyInvitations(userEmail: String): List<CommitteeMemberResponseDTO>
  +respondInvitation(committeeId: Long, userEmail: String, accept: boolean): CommitteeMemberResponseDTO
  +requestToJoin(committeeId: Long, userEmail: String): CommitteeMemberResponseDTO
  +listPendingJoinRequests(committeeId: Long, leaderEmail: String): List<CommitteeMemberResponseDTO>
  +respondJoinRequest(membershipId: Long, leaderEmail: String, approve: boolean): CommitteeMemberResponseDTO
  +listPendingJoinRequestsForOrganization(organizationId: Long, executorEmail: String): List<CommitteeMemberResponseDTO>
}
