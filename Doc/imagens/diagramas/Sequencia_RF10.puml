@startuml Sequencia_RF10
!pragma layout smetana
title
SpotMeet - Sequência do RF10 (Manter Comissão)
end title
hide footbox
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
autonumber "<b>0"

actor "Usuário" as U
box "Aplicativo (SpotMeetApp)" #F4F6FF
participant ":OrganizationScreen" as Tela
participant ":alerts" as Alerts
participant ":ConfirmationHost" as Conf
end box
box "API (backend)" #F6FFF4
participant ":JwtAuthFilter" as Filtro
participant ":CommitteeController" as Ctrl
participant ":CommitteeService" as Svc
participant ":UserRepository" as UserRepo
participant ":OrganizationRepository" as OrgRepo
participant ":OrganizationMemberRepository" as OrgMemRepo
participant ":CommitteeRepository" as ComRepo
participant ":CommitteeMemberRepository" as CmRepo
participant ":AuditLogRepository" as AuditRepo
participant ":GlobalExceptionHandler" as Handler
end box
note over AuditRepo : details representa simbolicamente o parâmetro textual de AuditLog,\ncom a comissão, organização e alterações; não é uma variável local.

group Pesquisar comissões (integrante da organização)
  U -> Tela : tocar na organização em "Minhas" (membro comum abre a lista; líder toca em "Comissões")
  Tela -> Filtro : GET /api/organizations/{organizationId}/committees
  Filtro -> Ctrl : listCommittees(organizationId, auth)
  Ctrl -> Svc : listCommittees(organizationId, email)
  activate Svc
  Svc -> UserRepo : findByEmail(userEmail)
  UserRepo --> Svc : User
  Svc -> OrgMemRepo : existsByUserIdAndOrganizationId(user.getId(), organizationId)
  OrgMemRepo --> Svc : boolean
  alt é integrante da organização
    Svc -> ComRepo : findByOrganizationIdOrderByNameAsc(organizationId)
    ComRepo --> Svc : List<Committee>
    loop cada comissão c
      Svc -> CmRepo : countByCommitteeIdAndStatus(c.getId(), CommitteeMembershipStatus.ACTIVE)
      CmRepo --> Svc : long
      Svc -> CmRepo : countByCommitteeIdAndStatus(c.getId(), CommitteeMembershipStatus.PENDING_USER_ACCEPTANCE)
      CmRepo --> Svc : long
      Svc -> CmRepo : countByCommitteeIdAndStatus(c.getId(), CommitteeMembershipStatus.PENDING_LEADER_APPROVAL)
      CmRepo --> Svc : long
      Svc -> CmRepo : findByCommitteeIdAndRole(c.getId(), CommitteeRole.COMMITTEE_ADMIN)
      CmRepo --> Svc : List<CommitteeMember>
      note right of Svc : usa o presidente com vínculo ACTIVE
    end
    Svc --> Ctrl : List<CommitteeResponseDTO>
    Ctrl --> Tela : 200 List<CommitteeResponseDTO>
    Tela --> U : exibe nome, descrição, "Presidente: nome" ou "Sem presidente definido",\no botão "Presidente" para os líderes e as etiquetas "N ativos" e "N pendentes" (ou "Nenhuma comissão cadastrada nesta organização.")
  else não é integrante
    Svc --> Ctrl : SecurityException
    Ctrl --> Handler : exceção propagada
    Handler --> Tela : 403 {message}
    Tela -> Tela : clearSelection()
    note right of Tela : volta para a aba "Minhas"
  end
  deactivate Svc
end

group Editar comissão (dono, vice ou subdono)
  U -> Tela : tocar em "Editar <comissão>"
  Tela --> U : abre a folha "Editar comissão" com os dados atuais
  U -> Tela : alterar os campos e tocar em "Salvar alterações"
  Tela -> Tela : handleSheetSave()
  note right of Tela : valida o nome com validateCommitteeName
  Tela -> Filtro : PUT /api/committees/{committeeId} (CommitteeRequestDTO)
  alt CommitteeRequestDTO inválido (@Valid)
    note over Ctrl, Handler : O Spring MVC valida o corpo antes do controller;
    note right of Handler : MethodArgumentNotValidException é tratada pelo handler.
    Handler --> Tela : 400 {message, errors}
    Tela --> U : exibe a mensagem do campo na folha
  else CommitteeRequestDTO válido
    Filtro -> Ctrl : updateCommittee(committeeId, dto, auth)
    Ctrl -> Svc : updateCommittee(committeeId, email, dto)
    activate Svc
    note over Svc : transação READ_COMMITTED
    Svc -> ComRepo : findById(committeeId)
    ComRepo --> Svc : Committee
    Svc -> UserRepo : findByEmail(leaderEmail)
    UserRepo --> Svc : User
    Svc -> OrgRepo : findByIdForUpdate(committee.getOrganization().getId())
    OrgRepo --> Svc : Organization (linha bloqueada)
    Svc -> Svc : requireOrganizationLeader(leader, committee.getOrganization().getId())
    Svc -> OrgMemRepo : findByUserIdAndOrganizationId(leader.getId(), organizationId)
    OrgMemRepo --> Svc : Optional<OrganizationMember>
    Svc -> Svc : validateName(dto.getName())
    Svc -> Svc : checkNameAvailability(organizationId, cleanName, committeeId)
    Svc -> ComRepo : existsByNormalizedName(organizationId, name, ValidationPatterns.ORGANIZATION_WHITESPACE, excludedId)
    note right of Svc : name e excludedId são parâmetros de checkNameAvailability; o ID atual é excluído
    ComRepo --> Svc : boolean
    alt é dono, vice ou subdono, a comissão existe e o nome não é de outra comissão
      note right of Svc : committee recebe o novo nome e a descrição
      Svc -> ComRepo : save(committee)
      ComRepo --> Svc : Committee saved
      Svc -> AuditRepo : save(new AuditLog(leader, "COMMITTEE_UPDATED", details))
      Svc -> CmRepo : countByCommitteeIdAndStatus(saved.getId(), CommitteeMembershipStatus.ACTIVE)
      CmRepo --> Svc : long
      Svc -> CmRepo : countByCommitteeIdAndStatus(saved.getId(), CommitteeMembershipStatus.PENDING_USER_ACCEPTANCE)
      CmRepo --> Svc : long
      Svc -> CmRepo : countByCommitteeIdAndStatus(saved.getId(), CommitteeMembershipStatus.PENDING_LEADER_APPROVAL)
      CmRepo --> Svc : long
      Svc --> Ctrl : CommitteeResponseDTO
      Ctrl --> Tela : 200 CommitteeResponseDTO
      Tela --> U : fecha a folha e exibe o aviso "Sucesso": "Comissão atualizada."
    else alguma regra violada
      Svc --> Ctrl : SecurityException ou IllegalArgumentException
      Ctrl --> Handler : exceção propagada
      Handler --> Tela : 403 (não é líder) ou 409 (nome repetido ou comissão não encontrada) {message}
      Tela --> U : exibe a mensagem acima dos botões da folha
    end
    deactivate Svc
  end
end

group Excluir comissão (dono ou vice, pelo aplicativo)
  U -> Tela : tocar em "Excluir <comissão>"
  Tela -> Alerts : confirmAction(title, message, execute, label, destructive, finish)
  note over Alerts, Conf : utilitário alerts encaminha a configuração ao ConfirmationHost;\ntítulo "Excluir comissão", label "Excluir", destructive true;\nexecute e finish são callbacks definidos na tela
  Conf --> U : exibe o diálogo com "Cancelar" e "Excluir"
  U -> Conf : tocar em "Excluir"
  Conf -> Tela : execute()
  Tela -> Filtro : DELETE /api/committees/{committeeId}
  Filtro -> Ctrl : deleteCommittee(committeeId, auth)
  Ctrl -> Svc : deleteCommittee(committeeId, email)
  activate Svc
  Svc -> ComRepo : findById(committeeId)
  ComRepo --> Svc : Committee
  Svc -> UserRepo : findByEmail(leaderEmail)
  UserRepo --> Svc : User
  Svc -> Svc : requireOrganizationLeader(leader, committee.getOrganization().getId())
  Svc -> OrgRepo : findById(organizationId)
  OrgRepo --> Svc : Organization
  Svc -> OrgMemRepo : findByUserIdAndOrganizationId(leader.getId(), organizationId)
  OrgMemRepo --> Svc : Optional<OrganizationMember>
  alt é dono, vice ou subdono e a comissão existe
    Svc -> CmRepo : findByCommitteeId(committeeId)
    CmRepo --> Svc : List<CommitteeMember> members
    Svc -> CmRepo : deleteAll(members)
    Svc -> ComRepo : delete(committee)
    Svc -> AuditRepo : save(new AuditLog(leader, "COMMITTEE_DELETED", details))
    Svc --> Ctrl : void
    Ctrl --> Tela : 200 "Comissão excluída com sucesso."
    Tela --> U : exibe o aviso "Sucesso": "Comissão excluída." e a lista sem a comissão
  else alguma regra violada
    Svc --> Ctrl : SecurityException ou IllegalArgumentException
    Ctrl --> Handler : exceção propagada
    Handler --> Tela : 403 (não é líder) ou 409 (comissão não encontrada) {message}
    Tela --> U : exibe a mensagem de erro
  end
  deactivate Svc
end
note over Svc : Nas consultas que devolvem Optional, o retorno com o nome da entidade\nrepresenta o valor extraído no sucesso; a ausência segue o ramo de erro indicado.
note over Tela : loadDetails carrega membros, comissões e pedidos ao selecionar a organização,\nao ganhar foco e na sincronização de 15 segundos. Abrir uma subpágina pode apenas\nmostrar esses dados já carregados, sem uma nova requisição causada pelo toque.
note over Svc : requireOrganizationLeader consulta OrganizationRepository.findById\nantes de conferir dono, vice-líder, subdono ou SYSADMIN.
note over U : confirmAction usa requestConfirmation do módulo utils/confirmation.\nConfirmationHost apresenta o pedido e executa o callback onConfirm após a confirmação.
@enduml
