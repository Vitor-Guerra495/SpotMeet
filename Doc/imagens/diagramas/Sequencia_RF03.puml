@startuml Sequencia_RF03
!pragma layout smetana
title
SpotMeet - Sequência do RF03 (Solicitar Acesso à Organização)
end title
hide footbox
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 280
autonumber "<b>0"

actor "Usuário" as U
box "Aplicativo (SpotMeetApp)" #F4F6FF
participant ":OrganizationScreen" as Tela
end box
box "API (backend)" #F6FFF4
participant ":JwtAuthFilter" as Filtro
participant ":MembershipController" as MCtrl
participant ":MembershipService" as MSvc
participant ":OrganizationInvitationController" as ICtrl
participant ":OrganizationInvitationService" as ISvc
participant ":OrganizationRepository" as OrgRepo
participant ":UserRepository" as UserRepo
participant ":OrganizationMemberRepository" as MemRepo
participant ":AccessRequestRepository" as ReqRepo
participant ":OrganizationInvitationRepository" as InvRepo
participant ":AuditLogRepository" as AuditRepo
end box
note over AuditRepo : details representa simbolicamente o parâmetro textual de AuditLog,\ncom nome e chave da organização no pedido, ou IDs do convite e organização na resposta;\nnão é uma variável local dos serviços.

group Listar as organizações da aba "Entrar"
  U -> Tela : abrir a aba "Entrar"
  Tela -> Filtro : GET /api/organizations/listed
  Filtro -> MCtrl : listedOrganizations(authentication)
  activate MCtrl
  MCtrl -> MSvc : listListed(email)
  activate MSvc
  MSvc -> UserRepo : findByEmail(userEmail)
  UserRepo --> MSvc : User
  MSvc -> MemRepo : findByUserId(user.getId())
  MemRepo --> MSvc : List<OrganizationMember>
  MSvc -> OrgRepo : findByApprovedTrueAndListedTrueOrderByNameAsc()
  OrgRepo --> MSvc : List<Organization>
  loop cada organização org aprovada e listada da qual o usuário não participa
    MSvc -> MemRepo : countByOrganizationId(org.getId())
    MemRepo --> MSvc : long
  end
  MSvc --> MCtrl : List<ListedOrganizationDTO>
  deactivate MSvc
  MCtrl --> Tela : 200 List<ListedOrganizationDTO> (id, name, accessKey, ownerName, memberCount)
  deactivate MCtrl
  Tela --> U : seção "ORGANIZAÇÕES NA LISTA" com "Buscar organização" (filtro local por nome)
  opt tocar numa organização da lista
    U -> Tela : tocar no cartão da organização
    Tela -> Tela : pickListed(org)
    note right of Tela : preenche a "Chave da organização" com a chave dela e marca o cartão
  end
end

group Conferir a organização pela chave
  U -> Tela : digitar a "Chave da organização" (ou preenchê-la pela lista)
  note right of Tela : com a chave em formato válido e 500 ms sem novas teclas
  Tela -> Filtro : GET /api/organizations/preview?accessKey=#chave
  Filtro -> MCtrl : previewOrganization(accessKey, authentication)
  activate MCtrl
  MCtrl -> MSvc : previewByKey(accessKey)
  activate MSvc
  note right of MSvc : leitura; as mesmas conferências do pedido, sem bloquear a organização
  MSvc -> OrgRepo : findIdsByAccessKeyIgnoreCase(cleanKey, ValidationPatterns.ORGANIZATION_WHITESPACE)
  OrgRepo --> MSvc : List<Long>
  alt organização aprovada com a chave
    MSvc -> OrgRepo : findById(matches.get(0))
    OrgRepo --> MSvc : Organization
    MSvc --> MCtrl : OrganizationPreviewDTO
    MCtrl --> Tela : 200 OrganizationPreviewDTO (name, accessKey, ownerName)
    Tela --> U : cartão com o nome e "Responsável: {dono}"
  else chave vazia ou inexistente, chave duplicada ou organização não aprovada
    MSvc --> MCtrl : IllegalArgumentException ou IllegalStateException
    MCtrl --> Tela : 404 ou 409 {message}
    Tela --> U : exibe a mensagem abaixo do campo
  end
  deactivate MSvc
  deactivate MCtrl
end

group Solicitar acesso pela chave
  U -> Tela : tocar em "Solicitar acesso" com a chave digitada na aba "Entrar"
  note right of Tela : o campo traz o # fixo; validateAccessKey exige de 2 a 50\nletras, números, "_" ou "-" antes de enviar
  Tela -> Filtro : POST /api/access-requests?accessKey=#chave
  Filtro -> MCtrl : requestAccess(body, accessKey, authentication)
  activate MCtrl
  note right of MCtrl : normaliza a chave (ValidationPatterns.normalizeOrganizationValue);\nchave vazia responde 400 {message}
  MCtrl -> MSvc : requestAccess(requesterEmail, accessKey)
  activate MSvc
  note right of MSvc : transação
  MSvc -> OrgRepo : findIdsByAccessKeyIgnoreCase(cleanKey, ValidationPatterns.ORGANIZATION_WHITESPACE)
  OrgRepo --> MSvc : List<Long>
  alt nenhuma organização com a chave
    MSvc --> MCtrl : IllegalArgumentException
    MCtrl --> Tela : 404 {message}
    Tela --> U : exibe a mensagem acima de "Solicitar acesso"
  else duas ou mais organizações com a chave
    MSvc --> MCtrl : IllegalStateException
    MCtrl --> Tela : 409 {message}
    Tela --> U : exibe a mensagem acima de "Solicitar acesso"
  else uma organização
    MSvc -> OrgRepo : findByIdForUpdate(matches.get(0))
    OrgRepo --> MSvc : Organization (linha bloqueada)
    MSvc -> UserRepo : findByEmail(requesterEmail)
    UserRepo --> MSvc : User requester
    MSvc -> MemRepo : existsByUserIdAndOrganizationId(requester.getId(), org.getId())
    MemRepo --> MSvc : boolean
    MSvc -> ReqRepo : findByUserIdAndOrganizationId(requester.getId(), org.getId())
    ReqRepo --> MSvc : List<AccessRequest>
    alt organização aprovada, usuário não é dono nem membro e sem pedido pendente
      note right of MSvc : cria ou reabre request com status PENDING e requestedAt atual
      MSvc -> ReqRepo : save(request)
      MSvc -> AuditRepo : save(new AuditLog(requester, "ACCESS_REQUESTED", details))
      MSvc --> MCtrl : AccessRequestResponseDTO
      MCtrl --> Tela : 201 AccessRequestResponseDTO
      Tela --> U : aviso "Solicitação enviada. Aguarde a aprovação dos responsáveis." e campo limpo
    else organização não aprovada ou bloqueada, usuário é dono ou já é membro, ou pedido já pendente
      MSvc --> MCtrl : IllegalStateException
      MCtrl --> Tela : 409 {message}
      Tela --> U : exibe a mensagem acima de "Solicitar acesso"
    end
  end
  deactivate MSvc
  deactivate MCtrl
end

group Consultar os convites recebidos
  U -> Tela : tocar em "Ver convites" na aba "Minhas"
  Tela -> Filtro : GET /api/organization-invitations/mine
  Filtro -> ICtrl : listMine(authentication)
  ICtrl -> ISvc : listMine(email)
  ISvc -> UserRepo : findByEmail(email)
  UserRepo --> ISvc : Optional<User>
  ISvc -> InvRepo : findPendingForRecipient(recipient.getId(), InvitationStatus.PENDING, Instant.now())
  InvRepo --> ISvc : List<OrganizationInvitation>
  ISvc --> ICtrl : List<OrganizationInvitationResponseDTO>
  ICtrl --> Tela : 200 List<OrganizationInvitationResponseDTO>
  Tela --> U : lista "CONVITES DE ORGANIZAÇÃO" com nome, quem convidou e "Válido até"
end

group Responder um convite
  U -> Tela : tocar em "Aceitar" ou "Recusar" no convite
  Tela -> Filtro : POST /api/organization-invitations/{invitationId}/respond (RespondOrganizationInvitationDTO)
  Filtro -> ICtrl : respond(invitationId, dto, authentication)
  activate ICtrl
  ICtrl -> ISvc : respond(invitationId, accept, email)
  activate ISvc
  note right of ISvc : transação
  ISvc -> UserRepo : findByEmail(email)
  UserRepo --> ISvc : Optional<User>
  ISvc -> InvRepo : findOrganizationIdForRecipient(invitationId, recipient.getId())
  InvRepo --> ISvc : Optional<Long>
  alt o convite não é deste usuário
    ISvc --> ICtrl : SecurityException
    ICtrl --> Tela : 403 {mensagem}
    Tela --> U : exibe a mensagem de erro
  else convite do usuário
    ISvc -> OrgRepo : findByIdForUpdate(organizationId)
    OrgRepo --> ISvc : Organization (linha bloqueada)
    ISvc -> InvRepo : findById(invitationId)
    InvRepo --> ISvc : OrganizationInvitation
    opt convite vigente, ainda pendente, aceite e organização aprovada
      ISvc -> MemRepo : existsByUserIdAndOrganizationId(recipient.getId(), organizationId)
      MemRepo --> ISvc : boolean
    end
    alt já respondido ou vencido (24 horas), ou aceite com organização não aprovada ou usuário já membro
      ISvc --> ICtrl : IllegalStateException
      ICtrl --> Tela : 409 {mensagem}
      Tela --> U : exibe a mensagem de erro
    else resposta válida
      alt aceitar
        note right of ISvc : member recebe papel MEMBER; pedidos pendentes passam a APPROVED
        ISvc -> MemRepo : save(member)
        ISvc -> ReqRepo : findByUserIdAndOrganizationId(recipient.getId(), organizationId)
        ReqRepo --> ISvc : List<AccessRequest>
        opt há pedido PENDING da mesma organização
          ISvc -> ReqRepo : save(request)
        end
        ISvc -> AuditRepo : save(new AuditLog(recipient, "ORGANIZATION_INVITATION_ACCEPTED", details))
      else recusar
        ISvc -> AuditRepo : save(new AuditLog(recipient, "ORGANIZATION_INVITATION_REJECTED", details))
      end
      note right of ISvc : invitation recebe ACCEPTED ou REJECTED e respondedAt atual
      ISvc -> InvRepo : save(invitation)
      ISvc --> ICtrl : OrganizationInvitationResponseDTO
      ICtrl --> Tela : 200 OrganizationInvitationResponseDTO
      Tela --> U : aviso "Convite aceito. Você entrou na organização." ou "Convite recusado."
    end
  end
  deactivate ISvc
  deactivate ICtrl
end
note over MSvc : Nas consultas que devolvem Optional, o retorno com o nome da entidade\nrepresenta o valor extraído no sucesso; a ausência segue o ramo de erro indicado.
note over MSvc : A primeira regra violada interrompe a operação;\nas consultas seguintes só são executadas após as validações anteriores.
note over Tela : loadDetails carrega membros, comissões e pedidos ao selecionar a organização,\nao ganhar foco e na sincronização de 15 segundos. Abrir uma subpágina pode apenas\nmostrar esses dados já carregados, sem uma nova requisição causada pelo toque.
@enduml
