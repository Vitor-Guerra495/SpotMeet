@startuml Diagrama_Classes_Entidades
!pragma layout smetana
title
SpotMeet - Classes da API: entidades, atributos e associações
end title
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 11
skinparam nodesep 25
skinparam ranksep 35
hide empty members
class User <<entidade>> {
  -id: Long
  -name: String
  -email: String
  -phone: String
  -password: String
  -role: String
  -emailVerified: boolean
  -tokensValidAfter: Instant
  -availabilityStatus: AvailabilityStatus
  -preferredTheme: PreferredTheme
  -bio: String
  -verificationToken: String
  -verificationTokenExpiresAt: LocalDateTime
  -recoveryToken: String
  -recoveryTokenExpiresAt: LocalDateTime
  -currentEmailChangeToken: String
  -currentEmailChangeTokenExpiresAt: LocalDateTime
  -pendingNewEmail: String
  -newEmailToken: String
  -newEmailTokenExpiresAt: LocalDateTime
}
class UserProfilePhoto <<entidade>> {
  -id: Long
  -imageData: byte[]
  -version: String
}
class Organization <<entidade>> {
  -moderationReason: String
  -resubmissionNote: String
  -resubmittedAt: LocalDateTime
  -id: Long
  -name: String
  -accessKey: String
  -cnpj: String
  -approved: boolean
  -listed: boolean
  -status: String
  -createdAt: LocalDateTime
}
class OrganizationMember <<entidade>> {
  -id: Long
  -role: OrganizationRole
}
class AccessRequest <<entidade>> {
  -id: Long
  -status: AccessRequestStatus
  -requestedAt: LocalDateTime
}
class OrganizationInvitation <<entidade>> {
  -id: Long
  -status: InvitationStatus
  -createdAt: Instant
  -expiresAt: Instant
  -respondedAt: Instant
}
class Committee <<entidade>> {
  -id: Long
  -name: String
  -description: String
  -createdAt: LocalDateTime
}
class CommitteeMember <<entidade>> {
  -id: Long
  -status: CommitteeMembershipStatus
  -role: CommitteeRole
  -requestedAt: LocalDateTime
  -respondedAt: LocalDateTime
}
class Meeting <<entidade>> {
  -id: Long
  -title: String
  -agenda: String
  -location: String
  -link: String
  -priority: MeetingPriority
  -startsAt: LocalDateTime
  -endsAt: LocalDateTime
  -allDay: boolean
  -modality: MeetingModality
  -canceledAt: LocalDateTime
  -cancelReason: String
  -attendanceListGeneratedAt: LocalDateTime
  -createdAt: LocalDateTime
  +statusAt(now: LocalDateTime): MeetingStatus
}
class MeetingParticipant <<entidade>> {
  -id: Long
  -response: InvitationResponse
  -responseComment: String
  -respondedAt: LocalDateTime
  -enteredAt: LocalDateTime
  -leftAt: LocalDateTime
}
class MeetingSeries <<entidade>> {
  -id: Long
  -frequency: Frequency
  -repeatInterval: int
  -weekDays: String
  -monthlyByWeekday: boolean
  -endDate: LocalDate
  -maxOccurrences: Integer
  -firstStartsAt: LocalDateTime
  -durationMinutes: long
  -lastStartsAt: LocalDateTime
  -createdCount: int
  -finished: boolean
  -title: String
  -agenda: String
  -location: String
  -link: String
  -modality: Meeting.MeetingModality
  -priority: Meeting.MeetingPriority
  -allDay: boolean
  -invitedUserIds: String
  -createdAt: LocalDateTime
}
class MeetingFile <<entidade>> {
  -id: Long
  -fileName: String
  -contentType: String
  -sizeBytes: long
  -data: byte[]
  -createdAt: LocalDateTime
}
class MeetingMinutes <<entidade>> {
  -id: Long
  -topics: String
  -decisions: String
  -notes: String
  -status: MinutesStatus
  -updatedAt: LocalDateTime
  -submittedAt: LocalDateTime
  -closedAt: LocalDateTime
}
class MinutesResponse <<entidade>> {
  -id: Long
  -approved: boolean
  -reason: String
  -respondedAt: LocalDateTime
}
class MeetingPoll <<entidade>> {
  -id: Long
  -question: String
  -description: String
  -openedAt: LocalDateTime
  -closedAt: LocalDateTime
  +closingTime(): LocalDateTime
}
class PollVote <<entidade>> {
  -id: Long
  -choice: VoteChoice
  -justification: String
  -votedAt: LocalDateTime
}
class AuditLog <<entidade>> {
  -id: Long
  -action: String
  -details: String
  -createdAt: LocalDateTime
}
enum AvailabilityStatus {
  PRESENT
  ONLINE
  BUSY
  AWAY
}
enum PreferredTheme {
  LIGHT
  DARK
  SYSTEM
}
enum OrganizationRole {
  ORG_OWNER
  ORG_VICE_OWNER
  ORG_SUBOWNER
  MEMBER
}
enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
enum CommitteeMembershipStatus {
  PENDING_USER_ACCEPTANCE
  PENDING_LEADER_APPROVAL
  ACTIVE
  DECLINED
}
enum CommitteeRole {
  COMMITTEE_ADMIN
  MEMBER
}
enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  ENDED
  CANCELED
}
enum MeetingPriority {
  LOW
  MEDIUM
  HIGH
}
enum MeetingModality {
  IN_PERSON
  ONLINE
  HYBRID
}
enum InvitationResponse {
  PENDING
  ACCEPTED
  DECLINED
}
enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum MinutesStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  REJECTED
}
enum VoteChoice {
  YES
  NO
  ABSTAIN
}
class "User" as UserRef_Organization_owner <<referência>> #F1F5FA
class "User" as UserRef_OrganizationMember_user <<referência>> #F1F5FA
class "User" as UserRef_AccessRequest_user <<referência>> #F1F5FA
class "User" as UserRef_OrganizationInvitation_user <<referência>> #F1F5FA
class "User" as UserRef_OrganizationInvitation_invitedBy <<referência>> #F1F5FA
class "User" as UserRef_CommitteeMember_user <<referência>> #F1F5FA
class "User" as UserRef_CommitteeMember_invitedBy <<referência>> #F1F5FA
class "User" as UserRef_Meeting_attendanceListGeneratedBy <<referência>> #F1F5FA
class "User" as UserRef_Meeting_createdBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingParticipant_user <<referência>> #F1F5FA
class "User" as UserRef_MeetingParticipant_enteredBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingParticipant_leftBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingSeries_createdBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingFile_uploadedBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingMinutes_writtenBy <<referência>> #F1F5FA
class "User" as UserRef_MinutesResponse_user <<referência>> #F1F5FA
class "User" as UserRef_MeetingPoll_openedBy <<referência>> #F1F5FA
class "User" as UserRef_MeetingPoll_closedBy <<referência>> #F1F5FA
class "User" as UserRef_PollVote_user <<referência>> #F1F5FA
class "User" as UserRef_AuditLog_user <<referência>> #F1F5FA
User +-- AvailabilityStatus
User +-- PreferredTheme
UserProfilePhoto "0..1" --> "1" User : user
Organization "*" --> "1" UserRef_Organization_owner : owner
OrganizationMember "*" --> "1" UserRef_OrganizationMember_user : user
OrganizationMember "*" --> "1" Organization : organization
OrganizationMember +-- OrganizationRole
AccessRequest "*" --> "1" UserRef_AccessRequest_user : user
AccessRequest "*" --> "1" Organization : organization
AccessRequest +-- AccessRequestStatus
OrganizationInvitation "*" --> "1" Organization : organization
OrganizationInvitation "*" --> "1" UserRef_OrganizationInvitation_user : user
OrganizationInvitation "*" --> "1" UserRef_OrganizationInvitation_invitedBy : invitedBy
OrganizationInvitation +-- InvitationStatus
Committee "*" --> "1" Organization : organization
CommitteeMember "*" --> "1" UserRef_CommitteeMember_user : user
CommitteeMember "*" --> "1" Committee : committee
CommitteeMember "*" --> "0..1" UserRef_CommitteeMember_invitedBy : invitedBy
CommitteeMember +-- CommitteeMembershipStatus
CommitteeMember +-- CommitteeRole
Meeting "*" --> "1" Committee : committee
Meeting "*" --> "0..1" MeetingSeries : series
Meeting "*" --> "0..1" MeetingFile : attachment
Meeting "*" --> "0..1" UserRef_Meeting_attendanceListGeneratedBy : attendanceListGeneratedBy
Meeting "*" --> "1" UserRef_Meeting_createdBy : createdBy
Meeting +-- MeetingStatus
Meeting +-- MeetingPriority
Meeting +-- MeetingModality
MeetingParticipant "*" --> "1" Meeting : meeting
MeetingParticipant "*" --> "1" UserRef_MeetingParticipant_user : user
MeetingParticipant "*" --> "0..1" UserRef_MeetingParticipant_enteredBy : enteredBy
MeetingParticipant "*" --> "0..1" UserRef_MeetingParticipant_leftBy : leftBy
MeetingParticipant +-- InvitationResponse
MeetingSeries "*" --> "1" Committee : committee
MeetingSeries "*" --> "1" UserRef_MeetingSeries_createdBy : createdBy
MeetingSeries "*" --> "0..1" MeetingFile : attachment
MeetingSeries +-- Frequency
MeetingFile "*" --> "1" Committee : committee
MeetingFile "*" --> "0..1" UserRef_MeetingFile_uploadedBy : uploadedBy
MeetingMinutes "0..1" --> "1" Meeting : meeting
MeetingMinutes "*" --> "1" UserRef_MeetingMinutes_writtenBy : writtenBy
MeetingMinutes +-- MinutesStatus
MinutesResponse "*" --> "1" MeetingMinutes : minutes
MinutesResponse "*" --> "1" UserRef_MinutesResponse_user : user
MeetingPoll "*" --> "1" Meeting : meeting
MeetingPoll "*" --> "1" UserRef_MeetingPoll_openedBy : openedBy
MeetingPoll "*" --> "0..1" UserRef_MeetingPoll_closedBy : closedBy
PollVote "*" --> "1" MeetingPoll : poll
PollVote "*" --> "1" UserRef_PollVote_user : user
PollVote +-- VoteChoice
AuditLog "*" --> "0..1" UserRef_AuditLog_user : user
legend bottom left
As setas apontam para a entidade referenciada.
1: uma ocorrência; 0..1: zero ou uma; *: zero ou mais.
O nome sobre a linha identifica o atributo da entidade de origem.
Os quadros User com o rótulo referência representam a mesma classe User.
São repetições visuais para separar as ligações, não entidades ou tabelas adicionais.
Os atributos completos e a ficha de User aparecem uma única vez.
endlegend
@enduml
