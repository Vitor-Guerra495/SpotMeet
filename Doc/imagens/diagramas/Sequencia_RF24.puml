@startuml Sequencia_RF24
!pragma layout smetana
title
SpotMeet - Sequência do RF24 (Designar Presidente da Comissão)
end title
hide footbox
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
autonumber "<b>0"

actor "Usuário\n(líder da organização)" as U
box "Aplicativo (SpotMeetApp)" #F4F6FF
participant ":OrganizationScreen" as Org
participant ":PresidentSheet" as Sheet
end box
box "API (backend)" #F6FFF4
participant ":JwtAuthFilter" as Filtro
participant ":CommitteeController" as Ctrl
participant ":CommitteeService" as Svc
participant ":CommitteeRepository" as ComRepo
participant ":UserRepository" as UserRepo
participant ":OrganizationRepository" as OrgRepo
participant ":OrganizationMemberRepository" as OrgMemRepo
participant ":CommitteeMemberRepository" as CmRepo
participant ":AuditLogRepository" as AuditRepo
participant ":GlobalExceptionHandler" as Handler
end box
note over AuditRepo : details representa simbolicamente o parâmetro textual de AuditLog,\ncom o ID da pessoa e nome da comissão; não é uma variável local.

U -> Org : tocar em "Presidente" (ação "Presidente de <comissão>")
Org -> Sheet : PresidentSheet({ committee, onClose, onChanged })

group Consultar integrantes ativos
  Sheet -> Filtro : GET /api/committees/{committeeId}/members
  Filtro -> Ctrl : listActiveMembers(committeeId, auth)
  Ctrl -> Svc : listActiveMembers(committeeId, email)
  Svc -> ComRepo : findById(committeeId)
  ComRepo --> Svc : Committee
  Svc -> UserRepo : findByEmail(userEmail)
  UserRepo --> Svc : User
  Svc -> CmRepo : existsByUserIdAndCommitteeIdAndStatus(user.getId(), committeeId, CommitteeMembershipStatus.ACTIVE)
  CmRepo --> Svc : boolean
  opt o usuário não é integrante ativo
    Svc -> Svc : requireOrganizationLeader(user, committee.getOrganization().getId())
  end
  Svc -> CmRepo : findByCommitteeIdAndStatus(committeeId, CommitteeMembershipStatus.ACTIVE)
  CmRepo --> Svc : List<CommitteeMember>
  Svc --> Ctrl : List<CommitteeMemberResponseDTO>
  Ctrl --> Sheet : 200 List<CommitteeMemberResponseDTO>
  Sheet --> U : exibe os integrantes, com a etiqueta "Presidente" no atual
end

group Designar o presidente
  U -> Sheet : tocar em "Definir presidente" e confirmar com "Definir"
  Sheet -> Filtro : PUT /api/committees/{committeeId}/president/{userId}
  Filtro -> Ctrl : assignPresident(committeeId, userId, auth)
  Ctrl -> Svc : assignPresident(committeeId, userId, email)
  activate Svc
  Svc -> ComRepo : findById(committeeId)
  ComRepo --> Svc : Committee
  Svc -> UserRepo : findByEmail(leaderEmail)
  UserRepo --> Svc : User
  Svc -> OrgRepo : findByIdForUpdate(committee.getOrganization().getId())
  OrgRepo --> Svc : Organization (linha bloqueada)
  Svc -> Svc : requireOrganizationLeader(leader, committee.getOrganization().getId())
  Svc -> OrgMemRepo : findByUserIdAndOrganizationId(leader.getId(), organizationId)
  OrgMemRepo --> Svc : OrganizationMember
  opt liderança validada
    Svc -> CmRepo : findByUserIdAndCommitteeId(targetUserId, committeeId)
    CmRepo --> Svc : Optional<CommitteeMember> target
  end
  alt é dono, vice ou subdono, e o escolhido é integrante ativo
    alt target já tem papel COMMITTEE_ADMIN
      note right of Svc : devolve o vínculo atual, sem gravar nem auditar de novo
    else outro integrante escolhido
      Svc -> CmRepo : findByCommitteeIdAndRole(committeeId, CommitteeRole.COMMITTEE_ADMIN)
      CmRepo --> Svc : List<CommitteeMember>
      loop cada presidente atual current
        note right of Svc : current recebe papel MEMBER
        Svc -> CmRepo : save(current)
      end
      note right of Svc : target recebe papel COMMITTEE_ADMIN
      Svc -> CmRepo : save(target)
      CmRepo --> Svc : CommitteeMember
      Svc -> AuditRepo : save(new AuditLog(leader, "COMMITTEE_PRESIDENT_ASSIGNED", details))
    end
    Svc --> Ctrl : CommitteeMemberResponseDTO
    Ctrl --> Sheet : 200 CommitteeMemberResponseDTO
    Sheet --> U : aviso "Presidente definido." e lista atualizada
    Sheet -> Org : onChanged()
    note right of Org : recarrega as comissões, mostrando "Presidente: <nome>"
  else não é líder, ou o escolhido não é integrante ativo
    Svc --> Ctrl : SecurityException ou IllegalStateException
    Ctrl --> Handler : exceção propagada
    Handler --> Sheet : 403 ou 409 {message}
    Sheet --> U : exibe a mensagem de erro
  end
  deactivate Svc
end
note over Svc : As validações são sequenciais: a primeira falha encerra a operação.\nAs chamadas seguintes só ocorrem se as anteriores forem aprovadas.
note over Svc : Nas consultas que devolvem Optional, o retorno com o nome da entidade\nrepresenta o valor extraído no sucesso; a ausência segue o ramo de erro indicado.
note over Svc : requireOrganizationLeader consulta OrganizationRepository.findById\nantes de conferir dono, vice-líder, subdono ou SYSADMIN.
note over U : confirmAction usa requestConfirmation do módulo utils/confirmation.\nConfirmationHost apresenta o pedido e executa o callback onConfirm após a confirmação.
@enduml
