@startuml Diagrama_Relacional
!pragma layout smetana
title
SpotMeet - Modelo relacional (PostgreSQL 18)
end title
hide circle
skinparam linetype ortho

entity "users" as users {
  *id : bigint <<PK>>
  *availability_status : varchar(255)
  bio : varchar(500)
  current_email_change_token : varchar(255)
  current_email_change_token_expires_at : timestamp
  *email : varchar(255)
  *email_verified : boolean
  *name : varchar(255)
  new_email_token : varchar(255)
  new_email_token_expires_at : timestamp
  *password : varchar(255)
  pending_new_email : varchar(255)
  phone : varchar(255)
  *preferred_theme : varchar(255)
  recovery_token : varchar(255)
  recovery_token_expires_at : timestamp
  *role : varchar(255)
  tokens_valid_after : timestamptz
  verification_token : varchar(255)
  verification_token_expires_at : timestamp
}

entity "user_profile_photos" as user_profile_photos {
  *id : bigint <<PK>>
  *image_data : bytea
  *user_id : bigint <<FK>>
  *version : varchar(36)
}

entity "organizations" as organizations {
  *id : bigint <<PK>>
  *access_key : varchar(100)
  *approved : boolean
  cnpj : varchar(255)
  *created_at : timestamp
  *listed : boolean
  moderation_reason : varchar(500)
  *name : varchar(255)
  *owner_id : bigint <<FK>>
  resubmission_note : varchar(500)
  resubmitted_at : timestamp
  status : varchar(255)
}

entity "organization_members" as organization_members {
  *id : bigint <<PK>>
  *organization_id : bigint <<FK>>
  *role : varchar(255)
  *user_id : bigint <<FK>>
}

entity "access_requests" as access_requests {
  *id : bigint <<PK>>
  *organization_id : bigint <<FK>>
  *requested_at : timestamp
  *status : varchar(20)
  *user_id : bigint <<FK>>
}

entity "organization_invitations" as organization_invitations {
  *id : bigint <<PK>>
  *created_at : timestamptz
  *expires_at : timestamptz
  *invited_by_id : bigint <<FK>>
  *organization_id : bigint <<FK>>
  responded_at : timestamptz
  *status : varchar(20)
  *user_id : bigint <<FK>>
}

entity "committees" as committees {
  *id : bigint <<PK>>
  created_at : timestamp
  description : varchar(500)
  *name : varchar(50)
  *organization_id : bigint <<FK>>
}

entity "committee_members" as committee_members {
  *id : bigint <<PK>>
  *committee_id : bigint <<FK>>
  invited_by_id : bigint <<FK>>
  requested_at : timestamp
  responded_at : timestamp
  *role : varchar(20)
  *status : varchar(30)
  *user_id : bigint <<FK>>
}

entity "meetings" as meetings {
  *id : bigint <<PK>>
  agenda : varchar(2000)
  *all_day : boolean
  attachment_id : bigint <<FK>>
  attendance_list_generated_at : timestamp
  attendance_list_generated_by_id : bigint <<FK>>
  cancel_reason : varchar(300)
  canceled_at : timestamp
  *committee_id : bigint <<FK>>
  created_at : timestamp
  *created_by_id : bigint <<FK>>
  *ends_at : timestamp
  link : varchar(300)
  location : varchar(100)
  modality : varchar(10)
  *priority : varchar(10)
  series_id : bigint <<FK>>
  *starts_at : timestamp
  *title : varchar(100)
}

entity "meeting_participants" as meeting_participants {
  *id : bigint <<PK>>
  entered_at : timestamp
  entered_by_id : bigint <<FK>>
  left_at : timestamp
  left_by_id : bigint <<FK>>
  *meeting_id : bigint <<FK>>
  responded_at : timestamp
  *response : varchar(20)
  response_comment : varchar(200)
  *user_id : bigint <<FK>>
}

entity "meeting_series" as meeting_series {
  *id : bigint <<PK>>
  agenda : varchar(2000)
  *all_day : boolean
  attachment_id : bigint <<FK>>
  *committee_id : bigint <<FK>>
  created_at : timestamp
  *created_by_id : bigint <<FK>>
  *created_count : integer
  *duration_minutes : bigint
  end_date : date
  *finished : boolean
  *first_starts_at : timestamp
  *frequency : varchar(10)
  invited_user_ids : varchar(4000)
  last_starts_at : timestamp
  link : varchar(300)
  location : varchar(100)
  max_occurrences : integer
  modality : varchar(10)
  *monthly_by_weekday : boolean
  *priority : varchar(10)
  *repeat_interval : integer
  *title : varchar(100)
  week_days : varchar(20)
}

entity "meeting_files" as meeting_files {
  *id : bigint <<PK>>
  *committee_id : bigint <<FK>>
  *content_type : varchar(100)
  *created_at : timestamp
  *data : bytea
  *file_name : varchar(150)
  *size_bytes : bigint
  uploaded_by_id : bigint <<FK>>
}

entity "meeting_minutes" as meeting_minutes {
  *id : bigint <<PK>>
  closed_at : timestamp
  decisions : varchar(4000)
  *meeting_id : bigint <<FK>>
  notes : varchar(2000)
  *status : varchar(20)
  submitted_at : timestamp
  topics : varchar(4000)
  *updated_at : timestamp
  *written_by_id : bigint <<FK>>
}

entity "minutes_responses" as minutes_responses {
  *id : bigint <<PK>>
  *approved : boolean
  *minutes_id : bigint <<FK>>
  reason : varchar(300)
  *responded_at : timestamp
  *user_id : bigint <<FK>>
}

entity "meeting_polls" as meeting_polls {
  *id : bigint <<PK>>
  closed_at : timestamp
  closed_by_id : bigint <<FK>>
  description : varchar(500)
  *meeting_id : bigint <<FK>>
  *opened_at : timestamp
  *opened_by_id : bigint <<FK>>
  *question : varchar(150)
}

entity "poll_votes" as poll_votes {
  *id : bigint <<PK>>
  *choice : varchar(10)
  justification : varchar(280)
  *poll_id : bigint <<FK>>
  *user_id : bigint <<FK>>
  *voted_at : timestamp
}

entity "audit_logs" as audit_logs {
  *id : bigint <<PK>>
  *action : varchar(255)
  *created_at : timestamp
  details : varchar(1000)
  user_id : bigint <<FK>>
}

access_requests }o--|| organizations : organization_id
access_requests }o--|| users : user_id
audit_logs }o--o| users : user_id
committee_members }o--|| committees : committee_id
committee_members }o--o| users : invited_by_id
committee_members }o--|| users : user_id
committees }o--|| organizations : organization_id
meeting_files }o--|| committees : committee_id
meeting_files }o--o| users : uploaded_by_id
meeting_minutes |o--|| meetings : meeting_id
meeting_minutes }o--|| users : written_by_id
meeting_participants }o--o| users : entered_by_id
meeting_participants }o--o| users : left_by_id
meeting_participants }o--|| meetings : meeting_id
meeting_participants }o--|| users : user_id
meeting_polls }o--o| users : closed_by_id
meeting_polls }o--|| meetings : meeting_id
meeting_polls }o--|| users : opened_by_id
meeting_series }o--o| meeting_files : attachment_id
meeting_series }o--|| committees : committee_id
meeting_series }o--|| users : created_by_id
meetings }o--o| meeting_files : attachment_id
meetings }o--o| users : attendance_list_generated_by_id
meetings }o--|| committees : committee_id
meetings }o--|| users : created_by_id
meetings }o--o| meeting_series : series_id
minutes_responses }o--|| meeting_minutes : minutes_id
minutes_responses }o--|| users : user_id
organization_invitations }o--|| users : invited_by_id
organization_invitations }o--|| organizations : organization_id
organization_invitations }o--|| users : user_id
organization_members }o--|| organizations : organization_id
organization_members }o--|| users : user_id
organizations }o--|| users : owner_id
poll_votes }o--|| meeting_polls : poll_id
poll_votes }o--|| users : user_id
user_profile_photos |o--|| users : user_id

legend bottom
  * campo obrigatório (NOT NULL). PK: chave primária. FK: chave estrangeira.
endlegend
@enduml
